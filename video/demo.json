  "voice": "en-US-ChristopherNeural",
  "settle": 1200,
  "brand": {
    "bg": "#0a0a0b",
    "fg": "#ece8e1",
    "acc": "#e2531c",
    "font": "Hanken Grotesk",
    "mono": "JetBrains Mono"
  },
  "intro": {
    "kicker": "Consilium · AI trading desk · paper mode",
    "title": "Four minds.<br><em>One trade.</em>"
  },
  "scenes": [
    {
      "say": "So this is Consilium. Four AI agents look at every trade, on Robinhood Chain stocks and on crypto, and the desk is live right here on the front page.",
      "steps": [
        [
          "goto",
          "http://consiliumdesk.xyz/"
        ],
        [
          "until",
          "document.getElementById('cli-out').innerText.includes('VERDICT')",
          60000
        ],
        [
          "wait",
          1200
        ]
      ]
    },
    {
      "say": "You can just type a command. Let's have them vote on Bitcoin.",
      "steps": [
        [
          "type",
          "#cli-in",
          "council BTC",
          70
        ],
        [
          "eval",
          "document.getElementById('cli-form').requestSubmit()"
        ],
        [
          "until",
          "!document.getElementById('cli-in').disabled",
          90000
        ],
        [
          "wait",
          1800
        ]
      ]
    },
    {
      "say": "Scout watches the trend. Quant checks if the move's stretched. Risk can veto anything, and Exec makes sure the order book can actually take the trade.",
      "steps": [
        [
          "glide",
          "#agents .step:nth-child(1)",
          0
        ],
        [
          "wait",
          2300
        ],
        [
          "glide",
          "#agents .step:nth-child(3)",
          0
        ],
        [
          "wait",
          2300
        ],
        [
          "glide",
          "#agents .step:nth-child(4)",
          0
        ],
        [
          "wait",
          1800
        ]
      ]
    },
    {
      "say": "The web desk is a live dashboard. Your paper balance, your positions, and how every market on your list is voting. Stocks and crypto, side by side.",
      "steps": [
        [
          "goto",
          "http://consiliumdesk.xyz/app?s=BTC"
        ],
        [
          "until",
          "document.querySelector('#b-verdict b')",
          60000
        ],
        [
          "wait",
          2500
        ],
        [
          "mouse",
          [
            [
              200,
              260
            ],
            [
              200,
              330
            ],
            [
              200,
              400
            ],
            [
              200,
              470
            ]
          ],
          20
        ]
      ]
    },
    {
      "say": "The chart's live too. Drop to one-minute candles, zoom in, and it just keeps moving.",
      "steps": [
        [
          "click",
          "#res [data-r='1m']"
        ],
        [
          "wait",
          2500
        ],
        [
          "mouse",
          [
            [
              700,
              480
            ],
            [
              720,
              470
            ]
          ],
          10
        ],
        [
          "eval",
          "(()=>{const c=document.querySelector('#chart canvas:last-of-type')||document.querySelector('#chart');const r=c.getBoundingClientRect();for(let i=0;i<6;i++)c.dispatchEvent(new WheelEvent('wheel',{deltaY:-200,clientX:r.left+r.width*0.7,clientY:r.top+r.height*0.5,bubbles:true,cancelable:true}))})()"
        ],
        [
          "wait",
          4500
        ]
      ]
    },
    {
      "say": "And the rules are yours. Pick cautious, and now all four have to agree, with tighter limits.",
      "steps": [
        [
          "click",
          ".ptabs [data-tab=rules]"
        ],
        [
          "wait",
          700
        ],
        [
          "click",
          ".presets [data-p=cautious]"
        ],
        [
          "wait",
          6000
        ]
      ]
    },
    {
      "say": "Then just ask an agent. Risk tells you exactly why it would, or wouldn't, block the trade.",
      "steps": [
        [
          "click",
          ".ptabs [data-tab=agents]"
        ],
        [
          "click",
          "#agent-pick [data-a=risk]"
        ],
        [
          "type",
          "#ask-q",
          "Would you veto Bitcoin under my rules?",
          40
        ],
        [
          "eval",
          "document.getElementById('ask-form').requestSubmit()"
        ],
        [
          "until",
          "!document.getElementById('ask-q').disabled",
          90000
        ],
        [
          "wait",
          1500
        ]
      ]
    },
    {
      "say": "Rather run it on your own machine? Grab the Windows app, the zip for Mac and Linux, or install it with one line.",
      "steps": [
        [
          "goto",
          "http://consiliumdesk.xyz/download"
        ],
        [
          "wait",
          2500
        ],
        [
          "glide",
          "#rows",
          120
        ],
        [
          "wait",
          1800
        ]
      ]
